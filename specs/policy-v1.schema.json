{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "env-host proposed policy v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "filesystem": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "rights": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "write",
                    "execute"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true,
                "minItems": 1
              },
              "recursive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "path",
              "rights",
              "recursive"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "rights": {
                "type": "array",
                "items": {
                  "enum": [
                    "read",
                    "write",
                    "execute"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true,
                "minItems": 1
              },
              "recursive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "path",
              "rights",
              "recursive"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        }
      },
      "required": [
        "allow",
        "deny"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "outbound": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "kind": {
                    "const": "origin"
                  },
                  "scheme": {
                    "const": "https"
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "scheme",
                  "host",
                  "port"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "kind": {
                    "const": "address"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 45
                  },
                  "transport": {
                    "enum": [
                      "tcp"
                    ]
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "address",
                  "transport",
                  "port"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 128
        },
        "listeners": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "enum": [
                  "127.0.0.1",
                  "::1"
                ]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "transport": {
                "const": "tcp"
              }
            },
            "required": [
              "address",
              "port",
              "transport"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "outbound",
        "listeners"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "inherit": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "export_entries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "maxItems": 1024,
          "uniqueItems": true
        },
        "public_config": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 128
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          }
        }
      },
      "required": [
        "inherit",
        "export_entries",
        "public_config"
      ],
      "additionalProperties": false
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "filesystem",
    "network",
    "environment",
    "integrations"
  ],
  "additionalProperties": false
}
